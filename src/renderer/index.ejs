<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <% if (htmlWebpackPlugin.options.isDevelopment) { %>
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline' http://localhost:8097"
    />
    <script src="http://localhost:8097"></script>
    <% } else { %>
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline'"
    />
    <% } %>
    <title>YellowFruit</title>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
